# ---- Offline demo mode (default: works with NO API keys) ----
LLM_BACKEND=mock            # mock | openai
EMBEDDING_BACKEND=local     # local | openai
VECTOR_BACKEND=memory       # memory | pinecone

# ---- Production mode: uncomment and fill ----
# LLM_BACKEND=openai
# EMBEDDING_BACKEND=openai
# VECTOR_BACKEND=pinecone
# OPENAI_API_KEY=sk-...
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX=knowledge-assistant
# PINECONE_NAMESPACE=enterprise-docs
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ---- Tuning ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE=0.15          # use ~0.25-0.30 with OpenAI embeddings
MAX_RETRIES=1
MAX_HISTORY=6
